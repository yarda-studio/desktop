{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Yarda",
  "windows": ["main", "presentation", "stage"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "updater:default",
    "process:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
